{
  "name": "simarukun-api",
  "version": "1.3.0",
  "description": "SimaRukun API - RT/RW Management System Backend",
  "author": "Priyo Gunawan",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --config jest.config.js",
    "test:unit": "jest --config jest.config.js --verbose",
    "test:unit:watch": "jest --config jest.config.js --watch --verbose",
    "test:unit:coverage": "jest --config jest.config.js --coverage --verbose",
    "test:integration": "jest --config jest.config.js --testPathPattern=integration --verbose",
    "test:e2e": "jest --config ./test/e2e/jest-e2e.json",
    "prestart:prod": "npm run build",
    "prebuild:prod": "rimraf dist"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.24",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.24",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.24",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/typeorm": "^11.0.3",
    "@node-rs/argon2": "^2.0.2",
    "@sentry/nestjs": "^8.55.2",
    "@sentry/node": "^10.7.0",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "nestjs-zod": "^5.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.10",
    "@nestjs/testing": "^11.0.24",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.15.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.2",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.8.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testTimeout": 10000,
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/../$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/../jest.setup.js"
    ],
    "globalSetup": "<rootDir>/../jest.global-setup.js",
    "globalTeardown": "<rootDir>/../jest.global-teardown.js"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
